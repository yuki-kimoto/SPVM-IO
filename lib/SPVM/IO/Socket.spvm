class IO::Socket extends IO::Handle {
  version_from IO;
  
  use Sys::Socket;
  use Sys::Socket::Constant as SOCKET_C;
  use Sys::Socket::Sockaddr;
  use Sys::Socket::Sockaddr::In;
  use Sys::Socket::Sockaddr::In6;
  use Sys::Socket::Sockaddr::Un;
  use Sys::Socket::In_addr;
  use Sys::Socket::Util;
  use Hash;
  use Errno;
  use Go;
  use Sys::Socket::Errno;
  use Fn;
  use Native::MethodCall;
  use Go::Time;
  use Go::Duration_1l;
  use Go::Error::IOTimeout;
  
  # Enumerations
  protected enum {
    SOCKET_CATEGORY_UNKNOWN,
    SOCKET_CATEGORY_CLIENT,
    SOCKET_CATEGORY_SERVER,
    SOCKET_CATEGORY_ACCEPTED,
  }
  
  # Fields
  has SocketCategory : int;
  
  has Domain : protected int;
  
  has Type : protected int;
  
  has Proto : protected int;
  
  has Listen : protected int;
  
  has LocalSockaddr : protected Sys::Socket::Sockaddr;
  
  has PeerSockaddr : protected Sys::Socket::Sockaddr;
  
  # Instance Methods
  protected method init : void ($options : object[] = undef) {
    
    $self->SUPER::init($options);
    
    my $options = Hash->new($options);
    
    # Domain option
    if ($options->exists("Domain")) {
      $self->{Domain} = $options->get("Domain")->(int);
    }
    
    # Proto option
    if ($options->exists("Proto")) {
      $self->{Proto} = $options->get("Proto")->(int);
    }
    
    # Type option
    if ($options->exists("Type")) {
      $self->{Type} = $options->get("Type")->(int);
    }
    
    # Listen option
    if ($options->exists("Listen")) {
      $self->{Listen} = $options->get("Listen")->(int);
      if ($self->{Listen} <= 0) {
        $self->{Listen} = SOCKET_C->SOMAXCONN;
      }
    }
    
    # Blocking option
    if ($options->exists("Blocking")) {
      die "Blocking option is not allowed in IO::Socket class and its child classes.";
    }
  }
  
  method option_names : string[] () {
    my $option_names = Array->merge_string(
      $self->SUPER::option_names,
      [
        "Domain",
        "Type",
        "Proto",
        "Listen",
      ]
    );
    return $option_names;
  }

  method sockdomain : int () {
    return $self->{Domain};
  }
  
  method socktype : int (){
    return $self->{Type};
  }
  
  method protocol : int () {
    return $self->{Proto};
  }
  
  method shutdown : void ($how : int) {
    my $fd = $self->{FD};
    Sys->shutdown($fd, $how);
  }
  
  method close : void () {
    unless ($self->opened) {
      die "This socket is not opened or already closed.";
    }
    my $fd = $self->{FD};
    Go->gosched_poll_cancel($fd);
    Sys::Socket->close($fd);
    $self->{FD} = -1;
  }
  
  method accept : IO::Socket ($context : Go::Context, $peer_ref : Sys::Socket::Sockaddr[] = undef) {
    my $fd = $self->{FD};
    my $accepted_fd = -1;
    my $accepted_sockaddr = (Sys::Socket::Sockaddr)undef;
    
    while (1) {
      $context = $self->get_context_with_deadline($context, 0);
      
      eval { $accepted_sockaddr = Sys->accept(\$accepted_fd, $fd); }
      if ($@) {
        my $again = Sys::Socket::Errno->is_accept_again(Sys::Socket::Errno->errno);
        if ($again) {
          Go->gosched_poll_read($context, $fd);
          next;
        }
        else {
          die $@;
        }
      }
      last;
    }
    
    my $options = {
      Context => Go->bg,
      FD => $accepted_fd,
      Domain => $self->{Domain},
      Type => $self->{Type},
      Proto => $self->{Proto},
    };
    
    my $class = type_name $self;
    my $accepted = (IO::Socket)Native::MethodCall->call_class_method($class, "new", [(object)$options]);
    if ($peer_ref) { $peer_ref->[0] = $accepted_sockaddr; }
    
    $self->{SocketCategory} = &SOCKET_CATEGORY_ACCEPTED;
    
    return $accepted;
  }
  
  method recvfrom : int ($context : Go::Context, $buffer : mutable string, $length : int, $flags : int, $from_ref : Sys::Socket::Sockaddr[], $offset : int = 0) {
    unless ($length >= 0) { $length = length $buffer; }
    my $fd = $self->{FD};
    my $recv_length = -1;
    while (1) {
      $context = $self->get_context_with_deadline($context, 0);
      eval { $recv_length = Sys->recvfrom($fd, $buffer, $length, $flags, $from_ref, $offset); }
      if ($@) {
        my $again = Sys::Socket::Errno->is_read_again(Sys::Socket::Errno->errno);
        if ($again) {
          Go->gosched_poll_read($context, $fd);
          next;
        }
        else {
          die $@;
        }
      }
      last;
    }
    return $recv_length;
  }
  
  
  method sendto : int ($context : Go::Context, $buffer : string, $flags : int, $to : Sys::Socket::Sockaddr, $length : int = -1, $offset : int = 0) {
    unless ($length >= 0) { $length = length $buffer; }
    my $fd = $self->{FD};
    my $send_length = -1;
    while (1) {
      $context = $self->get_context_with_deadline($context, 0);
      eval { $send_length = Sys->sendto($fd, $buffer, $flags, $to, $length, $offset); }
      if ($@) {
        my $again = Sys::Socket::Errno->is_write_again(Sys::Socket::Errno->errno);
        if ($again) {
          Go->gosched_poll_write($context, $fd);
          next;
        }
        else {
          die $@;
        }
      }
      last;
    }
    return $send_length;
  }
  
  method recv : int ($context : Go::Context, $buffer : mutable string, $length : int = -1, $flags : int = 0, $offset : int = 0) {
    return $self->recvfrom($context, $buffer, $length, $flags, (Sys::Socket::Sockaddr[])undef, $offset);
  }
  
  method send : int ($context : Go::Context, $buffer : string, $flags : int = 0, $length : int = -1, $offset : int = 0) {
    return $self->sendto($context, $buffer, $flags, (Sys::Socket::Sockaddr)undef, $length, $offset);
  }
  
  method sysread : int ($context : Go::Context, $buffer : mutable string, $length : int = -1, $offset : int = 0) {
    return $self->recv($context, $buffer, $length, 0, $offset);
  }
  
  method syswrite : int ($context : Go::Context, $buffer : string, $length : int = -1, $offset : int = 0) {
    return $self->send($context, $buffer, 0, $length, $offset);
  }
  
  method sockname : Sys::Socket::Sockaddr () {
    my $fd = $self->{FD};
    return Sys->getsockname($fd);
  }
  
  method peername : Sys::Socket::Sockaddr () {
    my $fd = $self->{FD};
    return Sys->getpeername($fd);
  }
  
  method connected : Sys::Socket::Sockaddr () {
    my $sockaddr = (Sys::Socket::Sockaddr)undef;
    eval { $sockaddr = $self->peername; };
    return $sockaddr;
  }
  
  method atmark : int () {
    my $fd = $self->{FD};
    return Sys::Socket->sockatmark($fd);
  }
  
  method sockopt : string ($level : int, $option_name : int) {
    my $fd = $self->{FD};
    return Sys->getsockopt($fd, $level, $option_name);
  }
  
  method setsockopt : void ($level : int, $option_name : int, $option_value : object of string|Int) {
    my $fd = $self->{FD};
    Sys->setsockopt($fd, $level, $option_name, $option_value);
  }
  
  protected method socket : void () {
    my $domain = $self->{Domain};
    my $type = $self->{Type};
    my $protocol = $self->{Proto};
    my $fd = -1;
    Sys->socket(\$fd, $domain, $type, $protocol);
    $self->{FD} = $fd;
  }
  
  protected method connect : void ($context : Go::Context) {
    my $fd = $self->{FD};
    my $sockaddr = $self->{PeerSockaddr};
    
    while (1) {
      $context = $self->get_context_with_deadline($context, 0);
      
      eval { Sys->connect($fd, $sockaddr); }
      if ($@) {
        my $again = Sys::Socket::Errno->is_connect_again(Sys::Socket::Errno->errno);
        if ($again) {
          Go->gosched_poll_write($context, $fd);
          next;
        }
        else {
          die $@;
        }
      }
      last;
    }
  }
  
  protected method bind : void () {
    my $sockaddr = $self->{LocalSockaddr};
    my $fd = $self->{FD};
    Sys->bind($fd, $sockaddr);
  }
  
  protected method listen : void () {
    if ($self->{Listen} > 0) {
      my $fd = $self->{FD};
      
      my $listen = $self->{Listen};
      if ($listen <= 0) {
        $listen = SOCKET_C->SOMAXCONN;
      }
      
      Sys->listen($fd, $listen);
    }
    else {
      die "'Listen' option not specified.'";
    }
  }
  
  method set_blocking : void ($blocking : int) {
    if ($blocking) {
      die "Calling set_blocking method given a true value on an IO::Socket object is forbidden.";
    }
    $self->SUPER::set_blocking($blocking);
  }
  
}
