class IO::Socket::IP extends IO::Socket {
  version_from IO;
  
  use Sys::Socket::Constant as SOCKET_C;
  use Sys::Socket::Sockaddr;
  use Sys::Socket::In_addr_base;
  
  use IO::Socket::IP::Import::IPv4;
  use IO::Socket::IP::Import::IPv6;
  
  # Fields
  has LocalAddr : protected string;
  
  has LocalPort : protected int;
  
  has PeerAddr : protected string;
  
  has PeerPort : protected int;
  
  has ReuseAddr : protected byte;
  
  has ReusePort : protected byte;
  
  has Broadcast : protected byte;
  
  has V6Only : byte;
  
  # Class Methods
  static method new : IO::Socket::IP ($options : object[] = undef) {
    
    my $self = new IO::Socket::IP;
    
    $self->init($options);
    
    $self->configure;
    
    return $self;
  }
  
  # Instance Methods
  protected method option_names : string[] () {
    
    my $option_names = Array->merge_string(
      $self->SUPER::option_names,
      [
        "PeerAddr",
        "PeerPort",
        "LocalAddr",
        "LocalPort",
        "ReuseAddr",
        "ReusePort",
        "Broadcast",
        "V6Only",
      ]
    );
    
    return $option_names;
  }
  
  protected method init : void ($options : object[] = undef) {
    
    my $options = Hash->new($options);
    
    # Domain
    my $domain = SOCKET_C->AF_INET;
    if ($options->exists("Domain")) {
      $domain = $options->get("Domain")->(int);
    }
    else {
      my $addr = (string)undef;
      if ($options->exists("LocalAddr")) {
        $addr = $options->get("LocalAddr")->(string);
      }
      elsif ($options->exists("PeerAddr")) {
        $addr = $options->get("PeerAddr")->(string);
      }
      
      if ($addr) {
        my $in_addr = (Sys::Socket::In_addr_base)undef;
        eval {
          $in_addr = Sys::Socket::Util->inet_pton(SOCKET_C->AF_INET6, $addr);
        };
        
        if ($in_addr) {
          $domain = SOCKET_C->AF_INET6;
        }
      }
    }
    
    # Type option
    my $type = $options->get_or_default("Type", SOCKET_C->SOCK_STREAM)->(int);
    
    $self->SUPER::init(Fn->merge_options($options->to_array, {Domain => $domain, Type => $type}));
    
    # LocalAddr
    if ($options->exists("LocalAddr")) {
      $self->{LocalAddr} = $options->get("LocalAddr")->(string);
    }
    
    # LocalPort
    if ($options->exists("LocalPort")) {
      $self->{LocalPort} = $options->get("LocalPort")->(int);
    }
    
    # PeerAddr
    if ($options->exists("PeerAddr")) {
      $self->{PeerAddr} = $options->get("PeerAddr")->(string);
    }
    
    # PeerPort
    if ($options->exists("PeerPort")) {
      $self->{PeerPort} = $options->get("PeerPort")->(int);
    }
    
    # ReuseAddr
    if ($options->exists("ReuseAddr")) {
      $self->{ReuseAddr} = $options->get("ReuseAddr")->(byte);
    }
    
    # ReusePort
    if ($options->exists("ReusePort")) {
      $self->{ReusePort} = $options->get("ReusePort")->(byte);
    }
    
    # Broadcast
    if ($options->exists("Broadcast")) {
      $self->{Broadcast} = $options->get("Broadcast")->(byte);
    }
    
    # V6Only option
    if ($options->exists("V6Only")) {
      $self->{V6Only} = $options->{"V6Only"}->(byte);
    }
  }
  
  protected method configure : void () {
    
    my $reuse_addr = $self->{ReuseAddr};
    
    my $reuse_port = $self->{ReusePort};
    
    my $broadcast = $self->{Broadcast};
    
    my $peer_address = $self->{PeerAddr};
    
    my $peer_port = $self->{PeerPort};
    
    my $local_address = $self->{LocalAddr};
    
    my $local_port = $self->{LocalPort};
    
    my $listen = $self->{Listen};
    
    my $fd = $self->{FD};
    
    unless ($fd >= 0) {
      $self->socket;
    }
    
    # These options must be before bind
    if ($reuse_addr) {
      $self->setsockopt(SOCKET_C->SOL_SOCKET, SOCKET_C->SO_REUSEADDR, 1);
    }
    if ($reuse_port) {
      $self->setsockopt(SOCKET_C->SOL_SOCKET, SOCKET_C->SO_REUSEPORT, 1);
    }
    if ($broadcast) {
      $self->setsockopt(SOCKET_C->SOL_SOCKET, SOCKET_C->SO_BROADCAST, 1);
    }
    if (exists $self->{V6Only}) {
      $self->setsockopt(SOCKET_C->IPPROTO_IPV6, SOCKET_C->IPV6_V6ONLY, !!$self->{V6Only});
    }
    
    if ($local_address || exists $self->{LocalPort}) {
      my $sockaddr = $self->create_sockaddr($local_address, $local_port);
      $self->{LocalSockaddr} = $sockaddr;
      # bind must before connect
      $self->bind;
    }
    
    if ($peer_address) {
      my $sockaddr = $self->create_sockaddr($peer_address, $peer_port);
      $self->{PeerSockaddr} = $sockaddr;
      $self->connect;
    }
    
    my $type = $self->socktype;
    if ($type == SOCKET_C->SOCK_STREAM) {
      $self->set_default_tcp_settings;
    }
    elsif ($type == SOCKET_C->SOCK_DGRAM) {
      $self->set_default_udp_settings;
    }
    
    # This must be after calling connect method because Mac does not support non-blocking mode to non-connected socket.
    $self->set_blocking(0);
    
    if ($self->{Listen} > 0) {
      $self->listen;
    }
  }
  
  method sockaddr : Sys::Socket::In_addr_base () {
    my $sockaddr = $self->sockname;
    
    my $in_addr_base = (Sys::Socket::In_addr_base)undef;
    
    my $domain = $self->{Domain};
    if ($domain == SOCKET_C->AF_INET) {
      $in_addr_base = $self->IO::Socket::IP::Import::IPv4::sockaddr;
    }
    elsif ($domain == SOCKET_C->AF_INET6) {
      $in_addr_base = $self->IO::Socket::IP::Import::IPv6::sockaddr;
    }
    else {
      die "[Unexpected Error]\$domain:$domain.";
    }
    
    return $in_addr_base;
  }
  
  method sockhost : string () {
    
    my $sockhost = (string)undef;
    
    my $domain = $self->{Domain};
    if ($domain == SOCKET_C->AF_INET) {
      $sockhost = $self->IO::Socket::IP::Import::IPv4::sockhost;
    }
    elsif ($domain == SOCKET_C->AF_INET6) {
      $sockhost = $self->IO::Socket::IP::Import::IPv6::sockhost;
    }
    else {
      die "[Unexpected Error]\$domain:$domain.";
    }
    
    return $sockhost;
  }
  
  method sockport : int () {
    
    my $sockport = -1;;
    
    my $domain = $self->{Domain};
    if ($domain == SOCKET_C->AF_INET) {
      $sockport = $self->IO::Socket::IP::Import::IPv4::sockport;
    }
    elsif ($domain == SOCKET_C->AF_INET6) {
      $sockport = $self->IO::Socket::IP::Import::IPv6::sockport;
    }
    else {
      die "[Unexpected Error]\$domain:$domain.";
    }
    
    return $sockport;
  }
  
  method peeraddr : Sys::Socket::In_addr_base () {
    
    my $in_addr_base = (Sys::Socket::In_addr_base)undef;
    
    my $domain = $self->{Domain};
    if ($domain == SOCKET_C->AF_INET) {
      $in_addr_base = $self->IO::Socket::IP::Import::IPv4::peeraddr;
    }
    elsif ($domain == SOCKET_C->AF_INET6) {
      $in_addr_base = $self->IO::Socket::IP::Import::IPv6::peeraddr;
    }
    else {
      die "[Unexpected Error]\$domain:$domain.";
    }
    
    return $in_addr_base;
  }
  
  method peerhost : string () {
    
    my $peerhost = (string)undef;
    
    my $domain = $self->{Domain};
    if ($domain == SOCKET_C->AF_INET) {
      $peerhost = $self->IO::Socket::IP::Import::IPv4::peerhost;
    }
    elsif ($domain == SOCKET_C->AF_INET6) {
      $peerhost = $self->IO::Socket::IP::Import::IPv6::peerhost;
    }
    else {
      die "[Unexpected Error]\$domain:$domain.";
    }
    
    return $peerhost;
  }
  
  method peerport : int () {
    
    my $peerport = -1;;
    
    my $domain = $self->{Domain};
    if ($domain == SOCKET_C->AF_INET) {
      $peerport = $self->IO::Socket::IP::Import::IPv4::peerport;
    }
    elsif ($domain == SOCKET_C->AF_INET6) {
      $peerport = $self->IO::Socket::IP::Import::IPv6::peerport;
    }
    else {
      die "[Unexpected Error]\$domain:$domain.";
    }
    
    return $peerport;
  }
  
  method accept : IO::Socket::IP ($peer_ref : Sys::Socket::Sockaddr[] = undef) {
    return (IO::Socket::IP)$self->SUPER::accept($peer_ref);
  }
  
  protected method create_sockaddr : Sys::Socket::Sockaddr ($address : string, $port : int) {
    
    my $sockaddr = (Sys::Socket::Sockaddr)undef;
    
    my $domain = $self->{Domain};
    if ($domain == SOCKET_C->AF_INET) {
      $sockaddr = $self->IO::Socket::IP::Import::IPv4::create_sockaddr($address, $port);
    }
    elsif ($domain == SOCKET_C->AF_INET6) {
      $sockaddr = $self->IO::Socket::IP::Import::IPv6::create_sockaddr($address, $port);
    }
    else {
      die "[Unexpected Error]\$domain:$domain.";
    }
    
    return $sockaddr;
  }
  
  protected method set_default_tcp_settings : void () {
    my $fd = $self->{FD};
    
    # 1. Disable Nagle's algorithm (TCP_NODELAY) as Go does by default.
    my $tcp_nodelay = 1;
    $self->setsockopt(Sys::Socket::Constant->IPPROTO_TCP, Sys::Socket::Constant->TCP_NODELAY, $tcp_nodelay);
    
    # 2. Enable TCP keep-alive with default settings (e.g., 15 seconds)
    # This matches Go's default behavior for net.Dialer.
    my $keepalive_onoff = 1;
    my $keepalive_idle_sec = 15;
    Sys::Socket::Util->set_tcp_keepalive($fd, $keepalive_onoff, $keepalive_idle_sec);
  }
  
  protected method set_default_udp_settings : void () {
    
    # Disable UDP connection reset on Windows for IPv4 sockets only
    if (Sys::OS->is_windows && $self->{Domain} == SOCKET_C->AF_INET) {
      my $SIO_UDP_CONNRESET = 0x98000007;
      my $optval = 0;
      $self->ioctl($SIO_UDP_CONNRESET, [$optval]);
    }
  }

}
