class IO::Socket::UNIX extends IO::Socket {
  version_from IO;
  
  use Sys::Socket::Constant as SOCKET_C;
  use Sys::Socket::Util;
  use Array;
  
  # Fields
  has local : string;
  
  has peer : string;
  
  # Class Methods
  static method new : IO::Socket::UNIX ($options : object[] = undef) {
    
    my $self = new IO::Socket::UNIX;
    
    $self->init($options);
    
    $self->configure;
    
    return $self;
  }
  
  # Instance Methods
  protected method option_names : string[] () {
    
    my $option_names = Array->merge_string(
      $self->SUPER::option_names,
      [
        "Local",
        "Peer",
      ]
    );
    
    return $option_names;
  }
  
  protected method init : void ($options : object[] = undef) {
    
    my $options = Hash->new($options);
    
    # Domain option
    my $domain = SOCKET_C->AF_UNIX;
    
    # Type option
    my $type = $options->get_or_default("Type", SOCKET_C->SOCK_STREAM)->(int);
    
    $self->SUPER::init(Fn->merge_options($options->to_array, {Domain => $domain, Type => $type}));
    
    # Peer option
    if ($options->exists("Peer")) {
      $self->{peer} = $options->get("Peer")->(string);
    }
    
    # Local option
    if ($options->exists("Local")) {
      $self->{local} = $options->get("Local")->(string);
    }
    
    if (exists $self->{listen}) {
      $self->{socket_category} = IO::Socket->SOCKET_CATEGORY_SERVER;
    }
    elsif (exists $self->{peer}) {
      $self->{socket_category} = IO::Socket->SOCKET_CATEGORY_CLIENT;
    }
    
    if (exists $self->{listen} && exists $self->{peer}) {
      die "'Listen' and 'Peer' options must not be specified togother.";
    }
  }
  
  protected method configure : void () {
    
    my $peer = $self->{peer};
    
    my $local = $self->{local};
    
    my $listen = $self->{listen};
    
    my $fd = $self->{fd};
    
    unless ($self->{context}) {
      die "Context must be defined. You perhaps forget to specify 'Context' option.";
    }
    
    unless ($fd >= 0) {
      $self->socket;
    }
    
    if ($local) {
      my $sockaddr = 
      $self->{local_sockaddr} = Sys::Socket::Util->sockaddr_un($local);
      # bind mube be before connect
      $self->bind;
    }
    
    if ($peer) {
      my $sockaddr = Sys::Socket::Util->sockaddr_un($peer);
      $self->{peer_sockaddr} = $sockaddr;
      $self->connect($self->{context});
    }
    
    # This must be after calling connect method because Mac does not support non-blocking mode to non-connected socket.
    $self->set_blocking(0);
    
    if ($self->{listen} > 0) {
      $self->listen;
    }
  }
  
  method hostpath : string () {
    my $sock_sockaddr_un = (Sys::Socket::Sockaddr::Un)$self->sockname;
    
    my $hostpath = $sock_sockaddr_un->sun_path;
    
    return $hostpath;
  }
  
  method peerpath : string () {
    my $peer_sockaddr_un = (Sys::Socket::Sockaddr::Un)$self->peername;
    
    my $peerpath = $peer_sockaddr_un->sun_path;
    
    return $peerpath;
  }
  
  method accept : IO::Socket::UNIX ($context : Go::Context, $peer_ref : Sys::Socket::Sockaddr[] = undef) {
    return (IO::Socket::UNIX)$self->SUPER::accept($context, $peer_ref);
  }
  
}
