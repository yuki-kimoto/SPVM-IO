class IO::Pipe::End extends IO::Handle {
  
  use Sys;
  use Go;
  
  static method new : IO::Pipe::End ($options : object[] = undef) {
    
    my $self = new IO::Pipe::End;
    
    $self->init($options);
    
    return $self;
  }
  
  protected method init : void ($options : object[] = undef) {
    
    $self->SUPER::init($options);
  }
  
  method sysread : int ($string : mutable string, $length : int = -1, $offset : int = 0) {
    
    unless ($length > -1) {
      $length = length $string;
    }
    
    my $fd = $self->{FD};
    my $timeout_duration = $self->get_remaining_duration(0);
    
    my $read_length = Go->gosched_pipe_read($fd, $string, $length, $offset, $timeout_duration);
    
    return $read_length;
  }
  
  method syswrite : int ($string : string, $length : int = -1, $offset : int = 0) {
    
    unless ($length > -1) {
      $length = length $string;
    }
    
    my $fd = $self->{FD};
    my $timeout_duration = $self->get_remaining_duration(1);
    
    my $write_length = Go->gosched_pipe_write($fd, $string, $length, $offset, $timeout_duration);
    
    return $write_length;
  }
  
  method close : void () {
    unless ($self->opened) {
      die "This socket is not opened or already closed.";
    }
    
    my $fd = $self->{FD};
    Go->gosched_pipe_cancel($fd);
    Sys::Socket->close($fd);
    $self->{FD} = -1;
  }
  
}
