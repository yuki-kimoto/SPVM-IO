class IO::Pipe::End extends IO::Handle {
  
  use Sys;
  use Go;
  
  static method new : IO::Pipe::End ($options : object[] = undef) {
    
    my $self = new IO::Pipe::End;
    
    $self->init($options);
    
    return $self;
  }
  
  protected method init : void ($options : object[] = undef) {
    
    $self->SUPER::init($options);
  }
  
  method sysread : int ($context : Go::Context, $string : mutable string, $length : int = -1, $offset : int = 0) {
    
    unless ($length > -1) {
      $length = length $string;
    }
    
    my $fd = $self->{fd};
    
    $context = $self->get_context_with_deadline($context, 0);
    my $read_length = Go->gosched_pipe_read($context, $fd, $string, $length, $offset);
    
    return $read_length;
  }
  
  method syswrite : int ($context : Go::Context, $string : string, $length : int = -1, $offset : int = 0) {
    
    unless ($length > -1) {
      $length = length $string;
    }
    
    my $fd = $self->{fd};
    
    $context = $self->get_context_with_deadline($context, 1);
    my $write_length = Go->gosched_pipe_write($context, $fd, $string, $length, $offset);
    
    return $write_length;
  }
  
  method close : void () {
    unless ($self->opened) {
      die "This socket is not opened or already closed.";
    }
    
    my $fd = $self->{fd};
    Go->gosched_pipe_cancel($fd);
    Sys::Socket->close($fd);
    $self->{fd} = -1;
  }
  
}
