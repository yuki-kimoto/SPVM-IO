class IO::Handle {
  version_from IO;
  
  use IO;
  use Sys;
  use Sys::IO;
  use Sys::IO::Constant as IO;
  use Sys::Ioctl::Constant as IOCTL;
  use Sys::IO::Stat;
  use Fn;
  use Format;
  use Scope::Guard;
  use Hash;
  use Sys::OS;
  use Sys::Socket::Util;
  use Go::Time;
  use Go::Context;
  
  # Fields
  has fd : protected int;
  
  has blocking : protected byte;
  
  has context : Go::Context; # This context is used only for connect method executed by new method.
  
  # Class Methods
  
  # Instance Methods
  protected method init : void ($options : object[] = undef) {
    
    Fn->check_option_names($options, $self->option_names);
    
    my $options = Hash->new($options);
    
    $self->{fd} = $options->get_or_default("FD", -1)->(int);
    
    $self->{blocking} = $options->get_or_default("Blocking", 1)->(byte);
    
    if ($options->exists("Context")) {
      $self->{context} = $options->get("Context")->(Go::Context);
    }
  }
  
  method option_names : string[] () {
    my $option_names = [
      "FD",
      "Blocking",
      "Context",
    ];
    
    return $option_names;
  }
  
  method opened : int () {
    my $opened = $self->{fd} >= 0;
    
    return $opened;
  }
  
  method fileno : int () {
    return $self->{fd};
  }
  
  method blocking : int () {
    return $self->{blocking};
  }
  
  method set_blocking : void ($blocking : int) {
    
    Sys::Socket::Util->set_blocking($self->{fd}, $blocking);
  }
  
  method close : void () { die "Not implemented."; }
  
  # $length is optional instead of Perl's one
  method sysread : int ($context : Go::Context, $string : mutable string, $length : int = -1, $offset : int = 0) {
    
    unless ($length > -1) {
      $length = length $string;
    }
    
    my $fd = $self->{fd};
    
    my $read_length = Sys->sysread($fd, $string, $length, $offset);
    
    return $read_length;
  }
  
  
  method syswrite : int ($context : Go::Context, $string : string, $length : int = -1, $offset : int = 0) {
    
    my $fd = $self->{fd};
    
    my $write_length = Sys->syswrite($fd, $string, $length, $offset);
    
    return $write_length;
  }
  
  method stat : Sys::IO::Stat () {
    my $fd = $self->{fd};
    
    my $stat = Sys->fstat($fd);
    
    return $stat;
  }
  
  method fcntl : int ($command : int, $command_arg : object of Int|Sys::IO::Flock|object = undef) {
    my $fd = $self->{fd};
    
    my $fcntl_ret = Sys->fcntl($fd, $command, $command_arg);
    
    return $fcntl_ret;
  }
  
  method ioctl : int ($request : int, $request_arg : object of byte[]|short[]|int[]|long[]|float[]|double[]|object = undef) {
    my $fd = $self->{fd};
    
    my $ioctl_ret =  Sys->ioctl($fd, $request, $request_arg);
    
    return $ioctl_ret;
  }
  
  method sync : void () { die "Not implemented."; }
  
  method truncate : void ($legnth : long) { die "Not implemented."; }
  
  method DESTROY : void () {
    
    if ($self->opened) {
      $self->close;
    }
    
  }
  
}
