class IO::Handle {
  version_from IO;
  
  use IO;
  use Sys;
  use Sys::IO;
  use Sys::IO::Constant as IO;
  use Sys::Ioctl::Constant as IOCTL;
  use Sys::IO::Stat;
  use Fn;
  use Format;
  use Scope::Guard;
  use Hash;
  use Sys::OS;
  use Sys::Socket::Util;
  use Go::Time;
  use Go::Context;
  
  # Fields
  has FD : protected int;
  
  has Blocking : protected byte;
  
  has ReadDeadline : Go::Time;
  
  has WriteDeadline : Go::Time;
  
  has Context : Go::Context;
  
  # Class Methods
  
  # Instance Methods
  protected method init : void ($options : object[] = undef) {
    
    Fn->check_option_names($options, $self->option_names);
    
    my $options = Hash->new($options);
    
    $self->{FD} = $options->get_or_default("FD", -1)->(int);
    
    $self->{Blocking} = $options->get_or_default("Blocking", 1)->(byte);
    
    if ($options->exists("ReadDeadline")) {
      $self->{ReadDeadline} = $options->get("ReadDeadline")->(Go::Time);
    }
    
    if ($options->exists("WriteDeadline")) {
      $self->{WriteDeadline} = $options->get("WriteDeadline")->(Go::Time);
    }
    
    # Context
    if ($options->exists("Context")) {
      $self->{Context} = $options->get("Context")->(Go::Context);
    }
  }
  
  method option_names : string[] () {
    my $option_names = [
      "FD",
      "Blocking",
      "ReadDeadline",
      "WriteDeadline",
      "Context",
    ];
    
    return $option_names;
  }
  
  method opened : int () {
    my $opened = $self->{FD} >= 0;
    
    return $opened;
  }
  
  method fileno : int () {
    return $self->{FD};
  }
  
  method blocking : int () {
    return $self->{Blocking};
  }
  
  method set_blocking : void ($blocking : int) {
    
    Sys::Socket::Util->set_blocking($self->{FD}, $blocking);
  }
  
  method close : void () { die "Not implemented."; }
  
  # $length is optional instead of Perl's one
  method sysread : int ($context : Go::Context, $string : mutable string, $length : int = -1, $offset : int = 0) {
    
    unless ($length > -1) {
      $length = length $string;
    }
    
    my $fd = $self->{FD};
    
    my $read_length = Sys->sysread($fd, $string, $length, $offset);
    
    return $read_length;
  }
  
  
  method syswrite : int ($context : Go::Context, $string : string, $length : int = -1, $offset : int = 0) {
    
    my $fd = $self->{FD};
    
    my $write_length = Sys->syswrite($fd, $string, $length, $offset);
    
    return $write_length;
  }
  
  method stat : Sys::IO::Stat () {
    my $fd = $self->{FD};
    
    my $stat = Sys->fstat($fd);
    
    return $stat;
  }
  
  method fcntl : int ($command : int, $command_arg : object of Int|Sys::IO::Flock|object = undef) {
    my $fd = $self->{FD};
    
    my $fcntl_ret = Sys->fcntl($fd, $command, $command_arg);
    
    return $fcntl_ret;
  }
  
  method ioctl : int ($request : int, $request_arg : object of byte[]|short[]|int[]|long[]|float[]|double[]|object = undef) {
    my $fd = $self->{FD};
    
    my $ioctl_ret =  Sys->ioctl($fd, $request, $request_arg);
    
    return $ioctl_ret;
  }
  
  method sync : void () { die "Not implemented."; }
  
  method truncate : void ($legnth : long) { die "Not implemented."; }
  
  protected method get_context_with_deadline : Go::Context ($context : Go::Context, $is_write : int) {
    unless ($context) {
      die "\$context must be defined.";
    }
    
    my $deadline = $is_write ? $self->{WriteDeadline} : $self->{ReadDeadline};
    
    my $result_context = $deadline ? Go::Context->with_deadline($context, $deadline)->context : $context;
    
    return $result_context;
  }
  
  method set_deadline : void ($deadline : Go::Time) {
    $self->{ReadDeadline} = $deadline;
    $self->{WriteDeadline} = $deadline;
  }
  
  method read_deadline : Go::Time () {
    return $self->{ReadDeadline};
  }
  
  method set_read_deadline : void ($deadline : Go::Time) {
    $self->{ReadDeadline} = $deadline;
  }
  
  method write_deadline : Go::Time () {
    return $self->{WriteDeadline};
  }
  
  method set_write_deadline : void ($deadline : Go::Time) {
    $self->{WriteDeadline} = $deadline;
  }
  
  method DESTROY : void () {
    
    if ($self->opened) {
      $self->close;
    }
    
  }
  
}
