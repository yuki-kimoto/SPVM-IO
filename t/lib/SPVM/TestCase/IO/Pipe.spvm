class TestCase::IO::Pipe {
  
  use IO::Pipe;
  use Go::Sync::WaitGroup;
  use Go;
  use Fn;
  
  static method basic : int () {
    
    my $success_ref = [1];
    
    my $wg = Go::Sync::WaitGroup->new;
    $wg->add(2);
    
    my $pipe = IO::Pipe->new;
    my $handles = $pipe->handles;
    
    Go->go([$wg : Go::Sync::WaitGroup, $success_ref : int[], $handles : IO::Pipe::End[]] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      my $out_str = "Hello SPVM Pipe 0\n";
      $handles->[0]->syswrite($out_str);
      
      my $in_str = (mutable string)new_string_len(length $out_str);
      my $read_length = $handles->[0]->sysread($in_str);
      
      unless ($read_length == length $out_str && $in_str eq $out_str) {
        diag;
        $success_ref->[0] = 0;
      }
    });
    
    Go->go([$wg : Go::Sync::WaitGroup, $success_ref : int[], $handles : IO::Pipe::End[]] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      my $in_str = (mutable string)new_string_len(19);
      my $read_length = $handles->[1]->sysread($in_str);
      
      unless ($read_length > 0) {
        diag;
        $success_ref->[0] = 0;
        return;
      }
      
      $handles->[1]->syswrite($in_str, $read_length);
    });
    
    $wg->wait;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
}
