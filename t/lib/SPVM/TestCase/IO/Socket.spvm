    my $success_ref = [0];
    
    Go->go([$success_ref : int[]] method : void () {
      $success_ref->[0] = 1;
      
      my $server = Test::Server::Echo->new;
      
      Fn->defer([$server :  Test::Server::Echo] method : void () {
        $server->stop;
      });
      
      Go->go([$server :  Test::Server::Echo] method : void () {
        $server->start;
      });
      
      $server->wait_start;
      my $port = $server->port;
      
      {
        my $host = "127.0.0.1";
        my $socket = IO::Socket::IP->new({PeerAddr => $host, PeerPort => $port});
        
        my $send_buffer = "GET /hello HTTP/1.0\r\nHost: $host\r\n\r\n";
        $socket->syswrite($send_buffer);
        
        $socket->shutdown(SOCKET->SHUT_WR);
        
        my $recv_buffer = (mutable string)new_string_len 1000;
        
        my $recv_length = $socket->sysread($recv_buffer);
        
        unless ($recv_length > 0 && $recv_length < 1000) {
          diag $recv_length;
          $success_ref->[0] = 0;
          return;
        }
        
        Fn->shorten_null_char($recv_buffer);
        
        my $content = $recv_buffer;
        
        unless (Fn->contains($content, "HTTP")) {
          diag dump $content;
          $success_ref->[0] = 0;
          return;
        }
        
        unless (Fn->contains($content, "hello")) {
          diag dump $content;
          $success_ref->[0] = 0;
          return;
        }
      }
      
      # Basic
      {
        my $host = "127.0.0.1";
        my $socket = IO::Socket::IP->new({PeerAddr => $host, PeerPort => $port});
        
        my $send_buffer = "GET /hello HTTP/1.0\r\nHost: $host\r\n\r\n";
        $socket->send($send_buffer);
        
        $socket->shutdown(SOCKET->SHUT_WR);
        
        my $recv_buffer = (mutable string)new_string_len 1000;
        
        my $recv_length = $socket->recv($recv_buffer);
        
        unless ($recv_length > 0 && $recv_length < 1000) {
          diag $recv_length;
          $success_ref->[0] = 0;
          return;
        }
        
        Fn->shorten_null_char($recv_buffer);
        
        my $content = $recv_buffer;
        
        unless (Fn->contains($content, "HTTP")) {
          diag dump $content;
          $success_ref->[0] = 0;
          return;
        }
        
        unless (Fn->contains($content, "hello")) {
          diag dump $content;
          $success_ref->[0] = 0;
          return;
        }
        
        $socket->close;
      }
      
      # Auto socket close
      {
        my $host = "127.0.0.1";
        my $socket = IO::Socket::IP->new({PeerAddr => $host, PeerPort => $port});
        
        my $send_buffer = "GET /hello HTTP/1.0\r\nHost: $host\r\n\r\n";
        $socket->send($send_buffer);
        
        $socket->shutdown(SOCKET->SHUT_WR);
        
        my $recv_buffer = (mutable string)new_string_len 1000;
        
        my $recv_length = $socket->recv($recv_buffer);
        
        unless ($recv_length > 0 && $recv_length < 1000) {
          diag $recv_length;
          $success_ref->[0] = 0;
          return;
        }
        
        Fn->shorten_null_char($recv_buffer);
        
        my $content = $recv_buffer;
        
        unless (Fn->contains($content, "hello")) {
          diag dump $content;
          $success_ref->[0] = 0;
          return;
        }
      }
      
      {
        my $host = "127.0.0.1";
        my $socket = IO::Socket::IP->new({PeerAddr => $host, PeerPort => $port});
        
        my $send_buffer = "GET /hello HTTP/1.0\r\nHost: $host\r\n\r\n";
        $socket->send($send_buffer);
        
        $socket->shutdown(SOCKET->SHUT_WR);
        
        my $recv_buffer = (mutable string)new_string_len 1000;
        
        my $recv_length = $socket->recv($recv_buffer);
        
        unless ($recv_length > 0 && $recv_length < 1000) {
          diag $recv_length;
          $success_ref->[0] = 0;
          return;
        }
        
        Fn->shorten_null_char($recv_buffer);
        
        my $content = $recv_buffer;
        
        unless (Fn->contains($content, "hello")) {
          diag dump $content;
          $success_ref->[0] = 0;
          return;
        }
      }
    });
    Go->gosched;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
  static method set_blocking : int () {
    
    my $success_ref = [0];
    
    Go->go([$success_ref : int[]] method : void () {
      $success_ref->[0] = 1;
      
      my $server = Test::Server::Echo->new;
      
      Fn->defer([$server :  Test::Server::Echo] method : void () {
        $server->stop;
      });
      
      Go->go([$server :  Test::Server::Echo] method : void () {
        $server->start;
      });
      
      $server->wait_start;
      my $port = $server->port;
      
      my $host = "127.0.0.1";
      my $socket = IO::Socket::IP->new({PeerAddr => $host, PeerPort => $port});
      
      eval { $socket->set_blocking(1); }
      
      unless ($@) {
        diag;
        $success_ref->[0] = 0;
        return;
      }
    });
    Go->gosched;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
  static method timeout : int () {
    
    my $success_ref = [0];
    
    Go->go([$success_ref : int[]] method : void () {
      $success_ref->[0] = 1;
      
      my $server = Test::Server::Echo->new;
      
      Fn->defer([$server :  Test::Server::Echo] method : void () {
        $server->stop;
      });
      
      Go->go([$server :  Test::Server::Echo] method : void () {
        $server->start;
      });
      
      $server->wait_start;
      my $port = $server->port;
      
      {
        my $host = "127.0.0.1";
        my $socket = IO::Socket::IP->new({PeerAddr => $host, PeerPort => $port});
        
        $socket->set_timeout(10.5);
        
        my $timeout = $socket->timeout;
        
        unless ($timeout == 10.5) {
          diag;
          $success_ref->[0] = 0;
          return;
        }
      }
    });
    Go->gosched;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
