class TestCase::IO::Socket {
  use IO::Socket;
  use IO::Socket::IP;
  use IO::Socket::UNIX;
  use Go::Sync::WaitGroup;
  use Go;
  use Fn;
  use Sys::Socket::Constant as SOCKET;
  
  static method fileno : int () {
    
    my $success_ref = [0];
    
    Go->go([$success_ref : int[]] method : void () {
      $success_ref->[0] = 1;
      
      my $server = Test::Server::Echo->new;
      
      Fn->defer([$server :  Test::Server::Echo] method : void () {
        $server->stop;
      });
      
      Go->go([$server :  Test::Server::Echo] method : void () {
        $server->start;
      });
      
      $server->wait_start;
      my $port = $server->port;
      
      my $host = "127.0.0.1";
      my $socket = IO::Socket::IP->new({PeerAddr => $host, PeerPort => $port});
      
      my $fileno = $socket->fileno;
      
      unless ($fileno > 2) {
        diag $fileno;
        $success_ref->[0] = 0;
        return;
      }
      
    });
    Go->gosched;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
  static method shutdown : int () {
    
    my $success_ref = [0];
    
    Go->go([$success_ref : int[]] method : void () {
      $success_ref->[0] = 1;
      
      my $server = Test::Server::Echo->new;
      
      Fn->defer([$server :  Test::Server::Echo] method : void () {
        $server->stop;
      });
      
      Go->go([$server :  Test::Server::Echo] method : void () {
        $server->start;
      });
      
      $server->wait_start;
      my $port = $server->port;
      
      {
        my $host = "127.0.0.1";
        my $socket = IO::Socket::IP->new({PeerAddr => $host, PeerPort => $port});
        
        $socket->shutdown(SOCKET->SHUT_WR);
      }
      
    });
    Go->gosched;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
  static method close : int () {
    
    my $success_ref = [0];
    
    Go->go([$success_ref : int[]] method : void () {
      $success_ref->[0] = 1;
      
      my $server = Test::Server::Echo->new;
      
      Fn->defer([$server :  Test::Server::Echo] method : void () {
        $server->stop;
      });
      
      Go->go([$server :  Test::Server::Echo] method : void () {
        $server->start;
      });
      
      $server->wait_start;
      my $port = $server->port;
      
      {
        my $host = "127.0.0.1";
        my $socket = IO::Socket::IP->new({PeerAddr => $host, PeerPort => $port});
        
        $socket->close;
      }
      
