  static method connect_deadline : int () {
    
    my $success_ref = [1];
    
    {
      # Use a deadline that has already passed to ensure an immediate timeout.
      my $deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(-1.0));
      
      my $socket = (IO::Socket::IP)undef;
      eval {
        $socket = IO::Socket::IP->new({
          PeerAddr => $LOCALHOST,
          ReadDeadline => $deadline,
          WriteDeadline => $deadline,
        });
      }
      
      if ($@) {
        # Check if the error is Go::Error::IOTimeout.
        unless ($@ isa Go::Error::IOTimeout) {
          diag "Unexpected error: " . $@;
          $success_ref->[0] = 0;
        }
      }
      else {
        # If the socket is created, the deadline check failed.
        diag "Connection unexpectedly succeeded despite an expired deadline.";
        $success_ref->[0] = 0;
        if ($socket) { $socket->close; }
      }
    }
    
    return $success_ref->[0];
  }
  
  static method read_deadline : int () {
    
    my $success_ref = [1];
    
    Go->go([$success_ref : int[]] method : void () {
      my $start_server_ch = Go->make;
      
      my $port_ref = [-1];
      Go->go([$port_ref : int[], $start_server_ch : Go::Channel] method : void () {
        eval {
          my $listen_socket = IO::Socket::IP->new({
            LocalAddr => $LOCALHOST,
            Listen => 5,
            ReuseAddr => 1,
          });
          
          $port_ref->[0] = $listen_socket->sockport;
          
          $start_server_ch->write(1);
          
          my $client_socket = $listen_socket->accept;
          
          Go->sleep(Go::Duration_1l->new_from_sec(1.0));
          
          $client_socket->close;
          $listen_socket->close;
        }
        if ($@) { diag "Server error: " . $@; }
      });
      
      $start_server_ch->read;
      my $port = $port_ref->[0];
      
      eval {
        # Connect to the server
        my $socket = IO::Socket::IP->new({
          PeerAddr => $LOCALHOST,
          PeerPort => $port,
        });
        
        # Set a short deadline (0.5 seconds from now)
        my $deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(0.5));
        $socket->set_deadline($deadline);
        
        my $buffer = (mutable string)new_string_len 1024;
        
        $socket->sysread($buffer);
        
        # If no exception is thrown, it's a failure.
        diag "sysread unexpectedly succeeded or returned 0 before deadline.";
        $success_ref->[0] = 0;
        $socket->close;
      }
      if ($@) {
        # Check if the error is exactly Go::Error::IOTimeout
        unless ($@ isa Go::Error::IOTimeout) {
          diag "Unexpected error type: " . $@;
          $success_ref->[0] = 0;
        }
      }
    });
    Go->gosched;
    
    return $success_ref->[0];
  }
  
  static method write_deadline : int () {
    
    my $success_ref = [1];
    
    Go->go([$success_ref : int[]] method : void () {
      my $start_server_ch = Go->make;
      
      my $port_ref = [-1];
      Go->go([$port_ref : int[], $start_server_ch : Go::Channel] method : void () {
        eval {
          my $listen_socket = IO::Socket::IP->new({
            LocalAddr => $LOCALHOST,
            Listen => 5,
            ReuseAddr => 1,
          });
          
          $port_ref->[0] = $listen_socket->sockport;
          
          $start_server_ch->write(1);
          
          my $client_socket = $listen_socket->accept;
          
          # Keep the connection alive longer than the client's deadline.
          Go->sleep(Go::Duration_1l->new_from_sec(2.0));
          
          $client_socket->close;
          $listen_socket->close;
        }
        if ($@) { diag "Server error: " . $@; }
      });
      
      $start_server_ch->read;
      my $port = $port_ref->[0];
      
      eval {
        my $socket = IO::Socket::IP->new({
          PeerAddr => $LOCALHOST,
          PeerPort => $port,
        });
        
        # Set a very short deadline to ensure it triggers.
        my $deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(0.5));
        $socket->set_deadline($deadline);
        
        # Smaller payload, but send many times.
        my $payload = Fn->repeat("a", 8192);
        
        while (1) {
          $socket->syswrite($payload);
        }
      }
      if ($@) {
        unless ($@ isa Go::Error::IOTimeout) {
          diag "Unexpected error: " . $@;
          $success_ref->[0] = 0;
        }
      } else {
        diag "Exited loop without exception";
        $success_ref->[0] = 0;
      }
    });
    Go->gosched;
    
    return $success_ref->[0];
  }
  
  static method accept_deadline : int () {
    
    my $success_ref = [1];
    
    Go->go([$success_ref : int[]] method : void () {
      eval {
        my $listen_socket = IO::Socket::IP->new({
          LocalAddr => $LOCALHOST,
          Listen => 5,
          ReuseAddr => 1,
        });
        
        my $deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(0.5));
        $listen_socket->set_deadline($deadline);
        
        my $client_socket = $listen_socket->accept;
        
        diag "accept unexpectedly succeeded before deadline.";
        $success_ref->[0] = 0;
        $client_socket->close;
        $listen_socket->close;
      }
      if ($@) {
        unless ($@ isa Go::Error::IOTimeout) {
          diag "Unexpected error type in accept: " . $@;
          $success_ref->[0] = 0;
        }
      }
    });
    Go->gosched;
    
    return $success_ref->[0];
  }
  
