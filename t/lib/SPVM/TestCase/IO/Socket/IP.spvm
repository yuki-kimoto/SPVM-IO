        my $read_data = (mutable string)new_string_len 1;
        
        eval { $socket->sysread($read_data); }
        
        unless ($@ && $@ isa Go::Error::IOTimeout) {
          diag;
          $success_ref->[0] = 0;
        }
        
      }
    });
    $wg->wait;
    
    Go->gosched;
    
    unless ($success_ref->[0]) {
