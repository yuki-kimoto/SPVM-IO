          $port_ref->[0] = $listen_socket->sockport;
          
          $start_server_ch->write(1);
          
          my $client_socket = $listen_socket->accept;
          
          Go->sleep(Go::Duration_1l->new_from_sec(1.0));
          
          $client_socket->close;
          $listen_socket->close;
        }
        if ($@) { diag "Server error: " . $@; }
      });
      
      $start_server_ch->read;
      my $port = $port_ref->[0];
      
      eval {
        my $socket = IO::Socket::IP->new({
          PeerAddr => $LOCALHOST,
          PeerPort => $port,
        });
        
        my $read_deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(0.3));
        my $far_deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(10.0));
        
        $socket->set_read_deadline($read_deadline);
        
        my $buffer = (mutable string)new_string_len 1024;
        $socket->sysread($buffer);
        
        diag "sysread unexpectedly succeeded before ReadDeadline.";
        $success_ref->[0] = 0;
      }
      if ($@) {
        unless ($@ isa Go::Error::IOTimeout) {
          diag "Unexpected error type in sysread: " . $@;
          $success_ref->[0] = 0;
        }
      }
    });
    Go->gosched;
    
    return $success_ref->[0];
  }
  
  static method write_deadline_specific : int () {
    
    my $success_ref = [1];
    
    Go->go([$success_ref : int[]] method : void () {
      my $start_server_ch = Go->make;
      
      my $port_ref = [-1];
      Go->go([$port_ref : int[], $start_server_ch : Go::Channel] method : void () {
        eval {
          my $listen_socket = IO::Socket::IP->new({
            LocalAddr => $LOCALHOST,
            Listen => 5,
            ReuseAddr => 1,
          });
          
          $port_ref->[0] = $listen_socket->sockport;
          
          $start_server_ch->write(1);
          
          my $client_socket = $listen_socket->accept;
          
          Go->sleep(Go::Duration_1l->new_from_sec(1.5));
          
          $client_socket->close;
          $listen_socket->close;
        }
        if ($@) { diag "Server error: " . $@; }
      });
      
      $start_server_ch->read;
      my $port = $port_ref->[0];
      
      eval {
        my $socket = IO::Socket::IP->new({
          PeerAddr => $LOCALHOST,
          PeerPort => $port,
        });
        
        # Set a short WriteDeadline.
        my $write_deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(0.3));
        $socket->set_write_deadline($write_deadline);
        
        my $payload = Fn->repeat("a", 8192);
        while (1) {
          $socket->syswrite($payload);
        }
      }
      if ($@) {
        unless ($@ isa Go::Error::IOTimeout) {
          diag "Unexpected error type in syswrite: " . $@;
          $success_ref->[0] = 0;
        }
      } else {
        $success_ref->[0] = 0;
      }
    });
    Go->gosched;
    
    return $success_ref->[0];
  }
  
}

