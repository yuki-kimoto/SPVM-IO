  static method read_timeout : int () {
    
    my $success_ref = [1];
    
    my $wg = Go::Sync::WaitGroup->new;
    
    $wg->add(2);
    
    my $wait_server_start_ch = Go->make;
    my $port_ref = [-1];
    Go->go([$wg : Go::Sync::WaitGroup, $wait_server_start_ch : Go::Channel, $port_ref : int[]] method : void () {
      
