class TestCase::IO::Socket::IP {
  use IO::Socket;
  use IO::Socket::IP;
  use IO::Socket::UNIX;
  use Go::Sync::WaitGroup;
  use Go;
  use Fn;
  use Sys::Socket::Constant as SOCKET;
  use Sys::OS;
  use Sys::Signal;
  use Sys::Signal::Constant as SIGNAL;
  
  our $LOCALHOST : string;
  our $LOCALHOST_V6 : string;
  INIT {
    unless (Sys::OS->is_windows) {
      Sys::Signal->signal(SIGNAL->SIGPIPE, Sys::Signal->SIG_IGN);
    }
    
    $LOCALHOST = "127.0.0.1";
    $LOCALHOST_V6 = "::1";
  }
  
  static method ipv4_new : int () {
    
    my $success_ref = [1];
    
    my $wg = Go::Sync::WaitGroup->new;
    
    $wg->add(2);
    
    my $wait_server_start_ch = Go->make;
    my $stop_server_ch = Go->make;
    
    my $port_ref = [-1];
    Go->go([$wg : Go::Sync::WaitGroup, $port_ref : int[], $wait_server_start_ch : Go::Channel, $stop_server_ch : Go::Channel] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      my $server_socket = IO::Socket::IP->new({
        LocalAddr => $LOCALHOST,
        Listen    => 5,
        ReuseAddr => 1,
      });
      
      $port_ref->[0] = $server_socket->sockport;
      
      $wait_server_start_ch->write(1);
      
      Go->go([$stop_server_ch : Go::Channel, $server_socket : IO::Socket::IP] method : void () {
        
        $stop_server_ch->read;
        
        $server_socket->close;
      });
      
      eval { $server_socket->accept; }
    });
    
    Go->go([$wg : Go::Sync::WaitGroup, $success_ref : int[], $port_ref : int[], $wait_server_start_ch : Go::Channel, $stop_server_ch : Go::Channel] method : void () {
      
      $wait_server_start_ch->read;
      
      my $port = $port_ref->[0];
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      {
        my $socket = IO::Socket::IP->new({PeerAddr => $LOCALHOST, PeerPort => $port});
        
        unless ($socket is_type IO::Socket::IP) {
          diag;
          $success_ref->[0] = 0;
        }
        
        unless ($socket->connected) {
          diag;
          $success_ref->[0] = 0;
        }
        
      }
      
      # Proto
      {
        # IPPROTO_UDP
        {
          my $socket = IO::Socket::IP->new({PeerAddr => $LOCALHOST, PeerPort => $port, Proto => SOCKET->IPPROTO_UDP});
          
          unless ($socket->protocol == SOCKET->IPPROTO_UDP) {
            diag;
            $success_ref->[0] = 0;
          }
          
          unless ($socket->socktype == SOCKET->SOCK_DGRAM) {
            diag;
            $success_ref->[0] = 0;
          }
        }
        
      }
      
      # Options
      {
        # ReuseAddr
        {
          my $socket = IO::Socket::IP->new({PeerAddr => $LOCALHOST, PeerPort => $port, ReuseAddr => 1});
          
          my $ret = Sys->getsockopt($socket->fileno, SOCKET->SOL_SOCKET, SOCKET->SO_REUSEADDR);
          
          unless ($ret) {
            diag;
            $success_ref->[0] = 0;
          }
        }
        
        # ReusePort
        if (Sys::OS->is_windows) {
          warn "[Skip Test]Windows do not support SO_REUSEPORT.";
        }
        else {
          my $socket = IO::Socket::IP->new({PeerAddr => $LOCALHOST, PeerPort => $port, ReusePort => 1});
          
          my $ret = Sys->getsockopt($socket->fileno, SOCKET->SOL_SOCKET, SOCKET->SO_REUSEPORT);
          
          unless ($ret) {
            diag;
            $success_ref->[0] = 0;
          }
        }
        
        # Broadcast
        {
          my $socket = IO::Socket::IP->new({PeerAddr => $LOCALHOST, PeerPort => $port, Proto => SOCKET->IPPROTO_UDP, Broadcast => 1});
          
          my $ret = Sys->getsockopt($socket->fileno, SOCKET->SOL_SOCKET, SOCKET->SO_BROADCAST);
          
          unless ($ret) {
            diag;
            $success_ref->[0] = 0;
          }
        }
      }
      
      # Exceptions
      {
        {
          eval { my $socket = IO::Socket::IP->new({PeerAddr => $LOCALHOST, Listen => 1}); }
          
          unless ($@) {
            diag;
            $success_ref->[0] = 0;
          }
        }
      }
      
      $stop_server_ch->write(1);
    });
    
    $wg->wait;
    
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
  static method ipv4_peerhost : int () {
    
    my $success_ref = [1];
    
    my $wg = Go::Sync::WaitGroup->new;
    
    $wg->add(2);
    
