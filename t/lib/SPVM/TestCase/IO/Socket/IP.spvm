  static method ipv6_new : int ($port : int) {
    
    {
      my $socket = IO::Socket::IP->new({PeerAddr => $LOCALHOST_V6, PeerPort => $port, Domain => SOCKET->AF_INET6});
      
      unless ($socket is_type IO::Socket::IP) {
        return 0;
      }
      
      unless ($socket->connected) {
        return 0;
      }
    }
    
    # Options
    {
      {
        my $socket = IO::Socket::IP->new({PeerAddr => $LOCALHOST_V6, PeerPort => $port, Domain => SOCKET->AF_INET6, V6Only => 1});
        
        my $ret = Sys->getsockopt($socket->fileno, SOCKET->IPPROTO_IPV6, SOCKET->IPV6_V6ONLY);
        
        unless ($ret) {
          return 0;
        }
      }
    }
    
    return 1;
  }
  
