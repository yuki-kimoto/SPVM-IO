  static method ipv6_new : int () {
    
    my $success_ref = [1];
    
    my $wg = Go::Sync::WaitGroup->new;
    
    $wg->add(2);
    
    my $wait_server_start_ch = Go->make;
    my $stop_server_ch = Go->make;
    
    my $port_ref = [-1];
    Go->go([$wg : Go::Sync::WaitGroup, $port_ref : int[], $wait_server_start_ch : Go::Channel, $stop_server_ch : Go::Channel] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      my $server_socket = IO::Socket::IP->new({
        Domain => SOCKET_C->AF_INET6,
        LocalAddr => $LOCALHOST_V6,
        Listen    => 5,
        ReuseAddr => 1,
      });
      
      $port_ref->[0] = $server_socket->sockport;
      
      $wait_server_start_ch->write(1);
      
      Go->go([$stop_server_ch : Go::Channel, $server_socket : IO::Socket::IP] method : void () {
        
        $stop_server_ch->read;
        
        $server_socket->close;
      });
      
      eval { $server_socket->accept; }
    });
    
    Go->go([$wg : Go::Sync::WaitGroup, $success_ref : int[], $port_ref : int[], $wait_server_start_ch : Go::Channel, $stop_server_ch : Go::Channel] method : void () {
      
      $wait_server_start_ch->read;
      
      my $port = $port_ref->[0];
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      {
        my $socket = IO::Socket::IP->new({PeerAddr => $LOCALHOST_V6, PeerPort => $port, Domain => SOCKET_C->AF_INET6});
        
        unless ($socket is_type IO::Socket::IP) {
          diag;
          $success_ref->[0] = 0;
        }
        
        unless ($socket->connected) {
          diag;
          $success_ref->[0] = 0;
        }
      }
      
      {
        {
          my $socket = IO::Socket::IP->new({PeerAddr => $LOCALHOST_V6, PeerPort => $port, Domain => SOCKET_C->AF_INET6, V6Only => 1});
          
          my $ret = Sys->getsockopt($socket->fileno, SOCKET_C->IPPROTO_IPV6, SOCKET_C->IPV6_V6ONLY);
          
          unless ($ret) {
            diag;
            $success_ref->[0] = 0;
          }
        }
      }
      
      $stop_server_ch->write(1);
    });
    
    $wg->wait;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
