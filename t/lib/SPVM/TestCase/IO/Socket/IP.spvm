        my $read_data = (mutable string)new_string_len 1;
        
        while (1) {
          
          my $read_length = $socket->sysread($read_data);
          
          if ($read_length > 0) {
            $string_buffer->push($read_data);
          }
          
          if ($read_data eq "\n") {
            last;
          }
        }
        
        unless ($string_buffer->to_string eq "abc\n") {
          $success_ref->[0] = 0;
        }
      }
    });
    
    $wg->wait;
    
    return $success_ref->[0];
