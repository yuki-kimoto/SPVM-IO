  static method accept : int () {
    
    my $success_ref = [1];
    
    my $wg = Go::Sync::WaitGroup->new;
    
    $wg->add(2);
    
    my $wait_server_start_ch = Go->make;
    
    my $port_ref = [-1];
    Go->go([$wg : Go::Sync::WaitGroup, $port_ref : int[], $wait_server_start_ch : Go::Channel] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      my $server_socket = IO::Socket::IP->new({
        LocalAddr => $LOCALHOST,
        Listen    => 5,
        ReuseAddr => 1,
      });
      
      $port_ref->[0] = $server_socket->sockport;
      
      $wait_server_start_ch->write(1);
      
      my $client_socket = $server_socket->accept;
      
      while (1) {
        
        my $data = (mutable string)new_string_len 1;
        
        my $read_length = $client_socket->sysread($data, length $data);
        
        if ($read_length > 0) {
          $client_socket->syswrite($data);
        }
        else {
          last;
        }
      }
    });
    
    Go->go([$wg : Go::Sync::WaitGroup, $success_ref : int[], $port_ref : int[], $wait_server_start_ch : Go::Channel] method : void () {
      
      $wait_server_start_ch->read;
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      {
        my $socket = IO::Socket::IP->new({PeerAddr => $LOCALHOST, PeerPort => $port_ref->[0]});
        
        my $write_data = "abc\n";
        
        $socket->syswrite($write_data);
        
        my $string_buffer = StringBuffer->new;
        
        my $read_data = (mutable string)new_string_len 1;
        
        while (1) {
          
          my $read_length = $socket->sysread($read_data);
          
          if ($read_length > 0) {
            $string_buffer->push($read_data);
          }
          
          if ($read_data eq "\n") {
            last;
          }
        }
        
        unless ($string_buffer->to_string eq "abc\n") {
          $success_ref->[0] = 0;
        }
      }
    });
    
    $wg->wait;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
  static method ipv6_extra : int () {
    my $success_ref = [0];
    
    my $wg = Go::Sync::WaitGroup->new;
    $wg->add(1);
    
    Go->go([$success_ref : int[], $wg : Go::Sync::WaitGroup] method : void () {
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      $success_ref->[0] = 1;
      
      my $server = Test::Server::Echo->new({
        LocalAddr => "::1",
        Domain => SOCKET_C->AF_INET6,
      });
      
      Fn->defer([$server : Test::Server::Echo] method : void () {
        $server->stop;
      });
      
      Go->go([$server : Test::Server::Echo] method : void () {
        $server->start;
      });
      
      $server->wait_start;
      my $port = $server->port;
      
      # Basic test
      {
        my $host = "::1";
        my $socket = IO::Socket::IP->new({
          PeerAddr => $host,
          PeerPort => $port,
          Domain => SOCKET_C->AF_INET6,
        });
        
        unless ($socket is_type IO::Socket::IP) {
          diag "socket type check failed";
          $success_ref->[0] = 0;
          return;
        }
        
        my $write_data = "Hello IPv6 Echo 1";
        $socket->syswrite($write_data);
        
        $socket->shutdown(SOCKET_C->SHUT_WR);
        
        my $read_data = (mutable string)new_string_len 1000;
        
        my $read_length = $socket->sysread($read_data);
        
        unless ($read_length > 0 && $read_length < 1000) {
          diag $read_length;
          $success_ref->[0] = 0;
          return;
        }
        
        Fn->shorten_null_char($read_data);
        
        my $content = $read_data;
        
        unless ($content eq $write_data) {
          diag dump $content;
          $success_ref->[0] = 0;
          return;
        }
        
        $socket->close;
      }
      
      # Auto socket close test
      {
        my $host = "::1";
        my $socket = IO::Socket::IP->new({
          PeerAddr => $host,
          PeerPort => $port,
          Domain => SOCKET_C->AF_INET6,
        });
        
        my $write_data = "Hello IPv6 Echo 2";
        $socket->syswrite($write_data);
        
        $socket->shutdown(SOCKET_C->SHUT_WR);
        
        my $read_data = (mutable string)new_string_len 1000;
        
        my $read_length = $socket->sysread($read_data);
        
        unless ($read_length > 0 && $read_length < 1000) {
          diag $read_length;
          $success_ref->[0] = 0;
          return;
        }
        
        Fn->shorten_null_char($read_data);
        
        my $content = $read_data;
        
        unless ($content eq $write_data) {
          diag dump $content;
          $success_ref->[0] = 0;
          return;
        }
      }
    });
    $wg->wait;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
