  static method accept : int () {
    
    my $success_ref = [1];
    
    my $wg = Go::Sync::WaitGroup->new;
    
    $wg->add(2);
    
    my $wait_server_start_ch = Go->make;
    
    my $port_ref = [-1];
    Go->go([$wg : Go::Sync::WaitGroup, $port_ref : int[], $wait_server_start_ch : Go::Channel] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      my $server_socket = IO::Socket::IP->new({
        LocalAddr => $LOCALHOST,
        Listen    => 5,
        ReuseAddr => 1,
      });
      
      $port_ref->[0] = $server_socket->sockport;
      
      $wait_server_start_ch->write(1);
      
      my $client_socket = $server_socket->accept;
      
      while (1) {
        
        my $data = (mutable string)new_string_len 1;
        
        my $read_length = $client_socket->sysread($data, length $data);
        
        if ($read_length > 0) {
          $client_socket->syswrite($data);
        }
        else {
          last;
        }
      }
    });
    
    Go->go([$wg : Go::Sync::WaitGroup, $success_ref : int[], $port_ref : int[], $wait_server_start_ch : Go::Channel] method : void () {
      
      $wait_server_start_ch->read;
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      {
        my $socket = IO::Socket::IP->new({PeerAddr => $LOCALHOST, PeerPort => $port_ref->[0]});
        
        my $write_data = "abc\n";
        
        $socket->syswrite($write_data);
        
        $socket->shutdown(SOCKET->SHUT_WR);
        
        my $string_buffer = StringBuffer->new;
        
        my $read_data = (mutable string)new_string_len 1;
        
        while (1) {
          
          my $read_length = $socket->sysread($read_data);
          
          if ($read_length > 0) {
            $string_buffer->push($read_data);
          }
          
          if ($read_data eq "\n") {
            last;
          }
        }
        
        unless ($string_buffer->to_string eq "abc\n") {
          $success_ref->[0] = 0;
        }
      }
    });
    
    $wg->wait;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
  static method ipv6_extra : int ($port : int) {
    
    # Basic
    {
      my $socket = IO::Socket::IP->new({PeerAddr => $LOCALHOST_V6, PeerPort => $port, Domain => SOCKET->AF_INET6});
      
      my $write_data = "GET /hello HTTP/1.0\r\nHost: $LOCALHOST_V6\r\n\r\n";
      $socket->syswrite($write_data);
      
      $socket->shutdown(SOCKET->SHUT_WR);
      
      my $read_data = (mutable string)new_string_len 1000;
      
      my $read_length = $socket->sysread($read_data);
      
      unless ($read_length > 0 && $read_length < 1000) {
        
        warn $read_length;
        return 0;
      }
      
      Fn->shorten_null_char($read_data);
      
      my $content = $read_data;
      
      unless (Fn->contains($content, "HTTP")) {
        
        warn dump $content;
        return 0;
      }
      
      unless (Fn->contains($content, "hello")) {
        
        warn dump $content;
        return 0;
      }
      
      $socket->close;
    }
    
    # Auto socket close
    {
      my $socket = IO::Socket::IP->new({PeerAddr => $LOCALHOST_V6, PeerPort => $port, Domain => SOCKET->AF_INET6});
      
      my $write_data = "GET /hello HTTP/1.0\r\nHost: $LOCALHOST_V6\r\n\r\n";
      $socket->syswrite($write_data);
      
      $socket->shutdown(SOCKET->SHUT_WR);
      
      my $read_data = (mutable string)new_string_len 1000;
      
      my $read_length = $socket->sysread($read_data);
      
      unless ($read_length > 0 && $read_length < 1000) {
        
        warn $read_length;
        return 0;
      }
      
      Fn->shorten_null_char($read_data);
      
      my $content = $read_data;
      
      unless (Fn->contains($content, "hello")) {
        
        warn dump $content;
        return 0;
      }
    }
    
    return 1;
  }
  
  static method accept_timeout_only_field_value : int () {
    
    my $success_ref = [1];
    
    my $wait_server_start_ch = Go->make;
    
    my $wg = Go::Sync::WaitGroup->new;
    
    $wg->add(2);
    
    my $port_ref = [-1];
    Go->go([$wg : Go::Sync::WaitGroup, $success_ref : int[], $port_ref : int[], $wait_server_start_ch : Go::Channel] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      {
        my $server_socket = IO::Socket::IP->new({
          LocalAddr => $LOCALHOST,
          Listen    => 5,
          ReuseAddr => 1,
          Timeout => 1.0,
        });
        
        $port_ref->[0] = $server_socket->sockport;
        
        $wait_server_start_ch->write(1);
        
        my $client_socket = (IO::Socket::IP)undef;
        eval { $client_socket = $server_socket->accept; }
        
        if ($@) {
          if ($@ isa Go::Error::IOTimeout) {
            return;
          }
          else {
            die $@;
          }
        }
        
        unless ($client_socket->timeout == 0) {
          $success_ref->[0] = 0;
        }
        
        while (1) {
          
          my $data = (mutable string)new_string_len 1;
          
          my $read_length = $client_socket->sysread($data, length $data);
          
          if ($read_length > 0) {
            $client_socket->syswrite($data);
          }
          else {
            last;
          }
        }
      }
      
    });
    
    Go->go([$wg : Go::Sync::WaitGroup, $success_ref : int[], $port_ref : int[], $wait_server_start_ch : Go::Channel] method : void () {
      
      $wait_server_start_ch->read;
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      {
        my $socket = IO::Socket::IP->new({PeerAddr => $LOCALHOST, PeerPort => $port_ref->[0]});
        
        my $write_data = "abc\n";
        
        $socket->syswrite($write_data);
        
        $socket->shutdown(SOCKET->SHUT_WR);
        
        my $string_buffer = StringBuffer->new;
        
        my $read_data = (mutable string)new_string_len 1;
        
        while (1) {
          
          my $read_length = $socket->sysread($read_data);
          
          if ($read_length > 0) {
            $string_buffer->push($read_data);
          }
          
          if ($read_data eq "\n") {
            last;
          }
        }
        
        unless ($string_buffer->to_string eq "abc\n") {
          $success_ref->[0] = 0;
        }
      }
    });
    
    $wg->wait;
    
    return $success_ref->[0];
  }
  
  static method read_timeout : int () {
    
    my $success_ref = [1];
    
    my $wg = Go::Sync::WaitGroup->new;
    
    $wg->add(2);
    
    my $wait_server_start_ch = Go->make;
    my $port_ref = [-1];
    Go->go([$wg : Go::Sync::WaitGroup, $wait_server_start_ch : Go::Channel, $port_ref : int[]] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      {
        my $server_socket = IO::Socket::IP->new({
          LocalAddr => $LOCALHOST,
          Listen    => 5,
          ReuseAddr => 1,
        });
        
        $port_ref->[0] = $server_socket->sockport;
        
        $wait_server_start_ch->write(1);
        
        my $client_socket = $server_socket->accept;
        
        Go->sleep_sec(0.5);
      }
      
    });
    
    Go->go([$wg : Go::Sync::WaitGroup, $success_ref : int[], $wait_server_start_ch : Go::Channel, $port_ref : int[]] method : void () {
      
      $wait_server_start_ch->read;
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      {
        my $socket = IO::Socket::IP->new({PeerAddr => $LOCALHOST, PeerPort => $port_ref->[0], Timeout => 0.25});
        
        my $read_data = (mutable string)new_string_len 1;
        
        eval { $socket->sysread($read_data); }
        
        unless ($@ && $@ isa Go::Error::IOTimeout) {
          diag;
          $success_ref->[0] = 0;
        }
        
      }
    });
    $wg->wait;
    
    Go->gosched;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
  static method connect_deadline : int ($port : int) {
    
    my $success_ref = [1];
    
    {
      # Use a deadline that has already passed to ensure an immediate timeout.
      my $deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(-1.0));
      
      my $socket = (IO::Socket::IP)undef;
      eval {
        $socket = IO::Socket::IP->new({
          PeerAddr => $LOCALHOST,
          PeerPort => $port,
          ReadDeadline => $deadline,
          WriteDeadline => $deadline,
        });
      }
      
      if ($@) {
        # Check if the error is Go::Error::IOTimeout.
        unless ($@ isa Go::Error::IOTimeout) {
          warn "Unexpected error: " . $@;
          $success_ref->[0] = 0;
        }
      }
      else {
        # If the socket is created, the deadline check failed.
        warn "Connection unexpectedly succeeded despite an expired deadline.";
        $success_ref->[0] = 0;
        if ($socket) { $socket->close; }
      }
    }
    
    return $success_ref->[0];
  }
  
  static method read_deadline : int ($port : int) {
    
    my $success_ref = [1];
    
    # Server side
    Go->go([$port : int] method : void () {
      eval {
        my $listen_socket = IO::Socket::IP->new({
          LocalAddr => $LOCALHOST,
          LocalPort => $port,
          Listen => 5,
          ReuseAddr => 1,
        });
        
        my $client_socket = $listen_socket->accept;
        
        # Sleep longer than the client's deadline to trigger the timeout.
        Go->sleep(Go::Duration_1l->new_from_sec(1.0));
        
        $client_socket->close;
        $listen_socket->close;
      }
      if ($@) { warn "Server error: " . $@; }
    });
    
    # Client side
    Go->go([$port : int, $success_ref : int[]] method : void () {
      eval {
        # Connect to the server
        my $socket = IO::Socket::IP->new({
          PeerAddr => $LOCALHOST,
          PeerPort => $port,
        });
        
        # Set a short deadline (0.5 seconds from now)
        my $deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(0.5));
        $socket->set_deadline($deadline);
        
        my $buffer = (mutable string)new_string_len 1024;
        
        $socket->sysread($buffer);
        
        # If no exception is thrown, it's a failure.
        warn "sysread unexpectedly succeeded or returned 0 before deadline.";
        $success_ref->[0] = 0;
        $socket->close;
      }
      if ($@) {
        # Check if the error is exactly Go::Error::IOTimeout
        unless ($@ isa Go::Error::IOTimeout) {
          warn "Unexpected error type: " . $@;
          $success_ref->[0] = 0;
        }
      }
    });
    
    # Run the scheduler until all goroutines are finished.
    Go->gosched;
    
    return $success_ref->[0];
  }
  
  static method write_deadline : int ($port : int) {
    
    my $success_ref = [1];
    my $ch_ready = Go->make(1);
    
    # Server side
    Go->go([$port : int, $ch_ready : Go::Channel] method : void () {
      eval {
        my $listen_socket = IO::Socket::IP->new({
          LocalAddr => $LOCALHOST,
          LocalPort => $port,
          Listen => 5,
          ReuseAddr => 1,
        });
        
        $ch_ready->write(1);
        
        # Accept the connection but DO NOT read.
        my $client_socket = $listen_socket->accept;
        
        # Keep the connection alive longer than the client's deadline.
        Go->sleep(Go::Duration_1l->new_from_sec(2.0));
        
        $client_socket->close;
        $listen_socket->close;
      }
      if ($@) { warn "Server error: " . $@; }
    });
    
    # Client side
    Go->go([$port : int, $success_ref : int[], $ch_ready : Go::Channel] method : void () {
      eval {
        $ch_ready->read;
        
        my $socket = IO::Socket::IP->new({
          PeerAddr => $LOCALHOST,
          PeerPort => $port,
        });
        
        # Set a very short deadline to ensure it triggers.
        my $deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(0.5));
        $socket->set_deadline($deadline);
        
        # Smaller payload, but send many times.
        my $payload = Fn->repeat("a", 8192);
        
        while (1) {
          $socket->syswrite($payload);
        }
      }
      if ($@) {
        unless ($@ isa Go::Error::IOTimeout) {
          warn "Unexpected error: " . $@;
          $success_ref->[0] = 0;
        }
      } else {
        warn "Exited loop without exception";
        $success_ref->[0] = 0;
      }
    });
    
    Go->gosched;
    return $success_ref->[0];
  }
  
  static method accept_deadline : int ($port : int) {
    
    my $success_ref = [1];
    
    # Server side (This is where the deadline check happens)
    Go->go([$port : int, $success_ref : int[]] method : void () {
      eval {
        my $listen_socket = IO::Socket::IP->new({
          LocalAddr => $LOCALHOST,
          LocalPort => $port,
          Listen => 5,
          ReuseAddr => 1,
        });
        
        # Set a short deadline for accept.
        my $deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(0.5));
        $listen_socket->set_deadline($deadline);
        
        # This should block and eventually throw DeadlineExceeded because no client connects.
        my $client_socket = $listen_socket->accept;
        
        # If no exception is thrown, it's a failure.
        warn "accept unexpectedly succeeded before deadline.";
        $success_ref->[0] = 0;
        $client_socket->close;
        $listen_socket->close;
      }
      if ($@) {
        # Check if the error is exactly Go::Error::IOTimeout
        unless ($@ isa Go::Error::IOTimeout) {
          warn "Unexpected error type in accept: " . $@;
          $success_ref->[0] = 0;
        }
      }
    });
    
    # Client side: In this test, we do nothing. 
    # By not connecting, we force the server's accept to timeout.
    
    # Run the scheduler until the server goroutine finishes.
    Go->gosched;
    
    return $success_ref->[0];
  }
  
  # Test for ReadDeadline
  static method read_deadline_specific : int ($port : int) {
    
    my $success_ref = [1];
    my $ch_ready = Go->make(1);
    
    # Server side
    Go->go([$port : int, $ch_ready : Go::Channel] method : void () {
      eval {
        my $listen_socket = IO::Socket::IP->new({
          LocalAddr => $LOCALHOST,
          LocalPort => $port,
          Listen => 5,
          ReuseAddr => 1,
        });
        $ch_ready->write(1);
        my $client_socket = $listen_socket->accept;
        # Server sleeps to trigger client-side read timeout
        Go->sleep(Go::Duration_1l->new_from_sec(1.0));
        $client_socket->close;
        $listen_socket->close;
      }
    });
    
    # Client side
    Go->go([$port : int, $success_ref : int[], $ch_ready : Go::Channel] method : void () {
      eval {
        $ch_ready->read;
        my $socket = IO::Socket::IP->new({
          PeerAddr => $LOCALHOST,
          PeerPort => $port,
        });
        
        # Set a short ReadDeadline.
        # Even if Deadline is set to a longer time, ReadDeadline should be prioritized.
        my $read_deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(0.3));
        my $far_deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(10.0));
        
        $socket->set_read_deadline($read_deadline);
        
        my $buffer = (mutable string)new_string_len 1024;
        $socket->sysread($buffer);
        
        warn "sysread unexpectedly succeeded before ReadDeadline.";
        $success_ref->[0] = 0;
      }
      if ($@) {
        unless ($@ isa Go::Error::IOTimeout) {
          warn "Unexpected error type in sysread: " . $@;
          $success_ref->[0] = 0;
        }
      }
    });
    
    Go->gosched;
    return $success_ref->[0];
  }

  # Test for WriteDeadline
  static method write_deadline_specific : int ($port : int) {
    
    my $success_ref = [1];
    my $ch_ready = Go->make(1);
    
    # Server side
    Go->go([$port : int, $ch_ready : Go::Channel] method : void () {
      eval {
        my $listen_socket = IO::Socket::IP->new({
          LocalAddr => $LOCALHOST,
          LocalPort => $port,
          Listen => 5,
          ReuseAddr => 1,
        });
        $ch_ready->write(1);
        my $client_socket = $listen_socket->accept;
        Go->sleep(Go::Duration_1l->new_from_sec(1.5));
        $client_socket->close;
        $listen_socket->close;
      }
    });
    
    # Client side
    Go->go([$port : int, $success_ref : int[], $ch_ready : Go::Channel] method : void () {
      eval {
        $ch_ready->read;
        my $socket = IO::Socket::IP->new({
          PeerAddr => $LOCALHOST,
          PeerPort => $port,
        });
        
        # Set a short WriteDeadline.
        my $write_deadline = Go::Time->now->add(Go::Duration_1l->new_from_sec(0.3));
        $socket->set_write_deadline($write_deadline);
        
        my $payload = Fn->repeat("a", 8192);
        while (1) {
          $socket->syswrite($payload);
        }
      }
      if ($@) {
        unless ($@ isa Go::Error::IOTimeout) {
          warn "Unexpected error type in syswrite: " . $@;
          $success_ref->[0] = 0;
        }
      } else {
        $success_ref->[0] = 0;
      }
    });
    
    Go->gosched;
    return $success_ref->[0];
  }
  
}

