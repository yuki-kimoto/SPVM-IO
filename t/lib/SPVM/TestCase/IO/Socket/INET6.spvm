class TestCase::IO::Socket::INET6 {
  use IO::Socket;
  use IO::Socket::INET6;
  use IO::Socket::UNIX;
  use Go::Sync::WaitGroup;
  use Go;
  use Fn;
  use Sys::Socket::Constant as SOCKET_C;
  use Test::Server::Echo;
  
  static method basic : int () {
    my $success_ref = [0];
    
    my $wg = Go::Sync::WaitGroup->new;
    $wg->add(1);
    
    Go->go([$success_ref : int[], $wg : Go::Sync::WaitGroup] method : void () {
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      $success_ref->[0] = 1;
      
      my $host = "::1";
      
      my $server = Test::Server::Echo->new({LocalAddr => $host});
      
      Fn->defer([$server : Test::Server::Echo] method : void () {
        $server->stop;
      });
      
      Go->go([$server : Test::Server::Echo] method : void () {
        $server->start;
      });
      
      $server->wait_start;
      my $port = $server->port;
      
      {
        my $socket = IO::Socket::INET6->new({PeerAddr => $host, PeerPort => $port});
        
        unless ($socket is_type IO::Socket::INET6) {
          diag "socket type check failed";
          $success_ref->[0] = 0;
          return;
        }
        
        my $write_date = "GET /hello HTTP/1.0\r\nHost: $host\r\n\r\n";
        $socket->syswrite($write_date);
        
        $socket->shutdown(SOCKET_C->SHUT_WR);
        
        my $read_date = (mutable string)new_string_len 1000;
        
        my $read_length = $socket->sysread($read_date);
        
        unless ($read_length > 0 && $read_length < 1000) {
          diag $read_length;
          $success_ref->[0] = 0;
          return;
        }
        
        Fn->shorten_null_char($read_date);
        
        my $content = $read_date;
        
        unless (Fn->contains($content, "HTTP")) {
          diag dump $content;
          $success_ref->[0] = 0;
          return;
        }
        
        unless (Fn->contains($content, "hello")) {
          diag dump $content;
          $success_ref->[0] = 0;
          return;
        }
        
        $socket->close;
      }
    });
    $wg->wait;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
}
