class TestCase::IO::Socket::UNIX {
  use IO::Socket;
  use IO::Socket::IP;
  use IO::Socket::UNIX;
  use Go::Sync::WaitGroup;
  use Go;
  use Fn;
  use Sys::Socket::Constant as SOCKET;
  
  static method new : int ($sock_path : string) {
    
    # Exceptions
    {
      {
        eval { my $socket = IO::Socket::UNIX->new({Peer => $sock_path, Local => $sock_path});; }
        
        unless ($@) {
          return 0;
        }
      }
    }
    
    return 1;
  }
  
  static method accept : int ($sock_path : string) {
    
    my $success_ref = [
      1,
    ];
    
    my $wait_server_start_ch = Go->make;
    
    my $wg = Go::Sync::WaitGroup->new;
    
    $wg->add(2);
    
    Go->go([$wg : Go::Sync::WaitGroup, $sock_path : string, $success_ref : int[], $wait_server_start_ch : Go::Channel] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      my $server_socket = IO::Socket::UNIX->new({
        Local => $sock_path,
        Listen    => 5,
      });
      
      $wait_server_start_ch->write(1);
      
      unless ($server_socket->hostpath eq $sock_path) {
        diag;
        $success_ref->[0] = 0;
      }
      
      my $client_socket = $server_socket->accept;
      
      unless ($client_socket->hostpath eq $sock_path) {
        diag;
        $success_ref->[0] = 0;
      }
      
      my $data = (mutable string)new_string_len 255;
      
      my $read_length = $client_socket->sysread($data);
      
      $client_socket->syswrite($data, $read_length);
    });
    
    Go->go([$wg : Go::Sync::WaitGroup, $success_ref : int[], $sock_path : string, $wait_server_start_ch : Go::Channel] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      $wait_server_start_ch->read;
      
      {
        my $socket = IO::Socket::UNIX->new({Peer => $sock_path});
        
        unless ($socket->connected) {
          diag;
          $success_ref->[0] = 0;
        }
        
        my $peerpath = $socket->peerpath;
        unless ($peerpath eq $sock_path) {
          diag;
          $success_ref->[0] = 0;
        }
        
        my $hostpath = $socket->hostpath;
        unless ($hostpath eq "") {
          diag;
          $success_ref->[0] = 0;
        }
        
        my $write_data = "abc\n";
        
        $socket->syswrite($write_data);
        
        my $string_buffer = StringBuffer->new;
        
        my $read_data = (mutable string)new_string_len 255;
        
        my $read_length = $socket->sysread($read_data);
        
        Fn->shorten($read_data, $read_length);
        
        unless ($read_data eq "abc\n") {
          diag;
          $success_ref->[0] = 0;
        }
      }
    });
    $wg->wait;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
}

