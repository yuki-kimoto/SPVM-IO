class TestCase::IO::Socket::UNIX {
  use IO::Socket;
  use IO::Socket::IP;
  use IO::Socket::UNIX;
  use Go::Sync::WaitGroup;
  use Go;
  use Fn;
  use Sys::Socket::Constant as SOCKET_C;
  use File::Temp;
  
  static method new : int () {
    
    return 1;
  }
  
  static method accept : int () {
    
    my $tmp_dir = File::Temp->newdir->dirname;
    my $sock_path = "$tmp_dir/test.sock";
    
    my $success_ref = [
      1,
    ];
    
    my $wait_server_start_ch = Go->make;
    
    my $wg = Go::Sync::WaitGroup->new;
    
    $wg->add(2);
    
    Go->go([$wg : Go::Sync::WaitGroup, $sock_path : string, $success_ref : int[], $wait_server_start_ch : Go::Channel] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      my $server_socket = IO::Socket::UNIX->new({
        Local => $sock_path,
        Listen    => 0,
      });
      
      unless (Fn->contains(dump $server_socket, SOCKET_C->SOMAXCONN)) {
        diag;
        $success_ref->[0] = 0;
      }
      
      $wait_server_start_ch->write(1);
      
      unless ($server_socket->hostpath eq $sock_path) {
        diag;
        $success_ref->[0] = 0;
      }
      
      my $client_socket = $server_socket->accept;
      
      unless ($client_socket->hostpath eq $sock_path) {
        diag;
        $success_ref->[0] = 0;
      }
      
      my $data = (mutable string)new_string_len 255;
      
      my $read_length = $client_socket->sysread($data);
      
      $client_socket->syswrite($data, $read_length);
    });
    
    Go->go([$wg : Go::Sync::WaitGroup, $success_ref : int[], $sock_path : string, $wait_server_start_ch : Go::Channel] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      $wait_server_start_ch->read;
      
      {
        my $socket = IO::Socket::UNIX->new({Peer => $sock_path});
        
        unless ($socket->connected) {
          diag;
          $success_ref->[0] = 0;
        }
        
        my $peerpath = $socket->peerpath;
        unless ($peerpath eq $sock_path) {
          diag;
          $success_ref->[0] = 0;
        }
        
        my $hostpath = $socket->hostpath;
        unless ($hostpath eq "") {
          diag;
          $success_ref->[0] = 0;
        }
        
        my $write_data = "abc\n";
        
        $socket->syswrite($write_data);
        
        my $string_buffer = StringBuffer->new;
        
        my $read_data = (mutable string)new_string_len 255;
        
        my $read_length = $socket->sysread($read_data);
        
        Fn->shorten($read_data, $read_length);
        
        unless ($read_data eq "abc\n") {
          diag;
          $success_ref->[0] = 0;
        }
      }
    });
    $wg->wait;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }

  static method dgram : int () {
    
    my $success_ref = [1];
    
    my $wg = Go::Sync::WaitGroup->new;
    
    $wg->add(2);
    
    my $wait_server_start_ch =Go->make;
    my $stop_server_ch = Go->make;
    
    my $dir = File::Temp->newdir->dirname;
    my $server_sock_path = "$dir/server.sock";
    my $client_sock_path = "$dir/client.sock";
    
    # Server goroutine
    Go->go([$wg : Go::Sync::WaitGroup, $server_sock_path : string, $wait_server_start_ch : Go::Channel, $stop_server_ch : Go::Channel, $success_ref : int[]] method : void () {
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      my $server_socket = IO::Socket::UNIX->new({
        Local => $server_sock_path,
        Type  => SOCKET_C->SOCK_DGRAM,
      });
      
      $wait_server_start_ch->write(1);
      
      Go->go([$stop_server_ch : Go::Channel, $server_socket : IO::Socket::UNIX] method : void () {
        $stop_server_ch->read;
        $server_socket->close;
      });
      
      # Handle packets
      my $i = 0;
      while ($i < 2) {
        my $buffer = (mutable string)new_string_len 1024;
        my $from_ref = [Sys::Socket::Sockaddr->new];
        my $read_length = -1;
        
        while (1) {
          eval {
            $read_length = $server_socket->recvfrom($buffer, length $buffer, 0, $from_ref);
          };
          if ($@) {
            my $errno = Sys::Socket::Errno->errno;
            if ($errno == Sys::Socket::Errno->ECONNRESET) {
              next;
            }
            $success_ref->[0] = 0;
            last;
          }
          last;
        }
        
        unless ($success_ref->[0]) {
          last;
        }
        
        if ($read_length > 0) {
          my $message = Fn->substr($buffer, 0, $read_length);
          my $peer = $from_ref->[0];
          my $sent_length = -1;
          
          while (1) {
            eval {
              $sent_length = $server_socket->sendto($message, 0, $peer);
            };
            if ($@) {
              my $errno = Sys::Socket::Errno->errno;
              if ($errno == Sys::Socket::Errno->ECONNRESET) {
                next;
              }
              $success_ref->[0] = 0;
              last;
            }
            last;
          }
          
          unless ($success_ref->[0]) {
            last;
          }
        }
        
        $i++;
      }
    });
    
    # Client goroutine
    Go->go([$wg : Go::Sync::WaitGroup, $success_ref : int[], $server_sock_path : string, $client_sock_path : string, $wait_server_start_ch : Go::Channel, $stop_server_ch : Go::Channel] method : void () {
      
      $wait_server_start_ch->read;
      
      Fn->defer([$wg : Go::Sync::WaitGroup] method : void () {
        $wg->done;
      });
      
      {
        my $socket = IO::Socket::UNIX->new({
          Local => $client_sock_path,
          Peer  => $server_sock_path,
          Type  => SOCKET_C->SOCK_DGRAM,
        });
        
        # Perform exchanges
        my $i = 0;
        while ($i < 2) {
          my $write_data = "packet " . ($i + 1) . "\n";
          my $sent_length = -1;
          
          while (1) {
            eval {
              $sent_length = $socket->send($write_data);
            };
            if ($@) {
              my $errno = Sys::Socket::Errno->errno;
              if ($errno == Sys::Socket::Errno->ECONNRESET) {
                next;
              }
              $success_ref->[0] = 0;
              last;
            }
            last;
          }
          
          unless ($success_ref->[0]) {
            last;
          }
          
          my $read_data = (mutable string)new_string_len 1024;
          my $read_length = -1;
          
          while (1) {
            eval {
              $read_length = $socket->recv($read_data, length $read_data);
            };
            if ($@) {
              my $errno = Sys::Socket::Errno->errno;
              if ($errno == Sys::Socket::Errno->ECONNRESET) {
                next;
              }
              $success_ref->[0] = 0;
              last;
            }
            last;
          }
          
          unless ($success_ref->[0]) {
            last;
          }
          
          if ($read_length > 0) {
            my $response = Fn->substr($read_data, 0, $read_length);
            unless ($response eq $write_data) {
              $success_ref->[0] = 0;
            }
          }
          
          $i++;
        }
      }
      
      $stop_server_ch->write(1);
    });
    
    $wg->wait;
    
    unless ($success_ref->[0]) {
      return 0;
    }
    
    return 1;
  }
  
}

