class Test::Server::Echo {
  use Go;
  use IO::Socket::IP;
  use Sys::Socket::Constant as SOCKET_C;
  use Fn;
  
  has start_server_ch : Go::Channel;
  
  has stop_server_ch : Go::Channel;
  
  has port : ro int;
  
  has server_socket : IO::Socket::IP;
  
  has accepted_socket : IO::Socket::IP;
  
  has is_running : byte;
  
  has LocalAddr : ro string;
  
  has Domain : ro int;
  
  static method new : Test::Server::Echo ($options : object[] = undef) {
    my $self = new Test::Server::Echo;
    
    $self->{start_server_ch} = Go->make;
    
    $self->{stop_server_ch} = Go->make;
    
    my $options = Fn->to_hash($options);
    
    $self->{LocalAddr} = $options->exists("LocalAddr") ? $options->{"LocalAddr"}->(string) : "127.0.0.1";
    
    if ($options->exists("Domain")) {
      $self->{Domain} =  $options->{"Domain"}->(int);
    }
    
    return $self;
  }
  
  method start : void () {
    my $LocalAddr = $self->{LocalAddr};
    
    my $server_options_h = Hash->new({
      LocalAddr => $LocalAddr,
      Listen => SOCKET_C->SOMAXCONN,
    });
    
    if (exists $self->{Domain}) {
      $server_options_h->{"Domain"} = $self->{Domain};
    }
    
    # Create server socket with LocalAddr
    my $server_socket = IO::Socket::IP->new($server_options_h->to_options);
    
    unless ($server_socket) {
      die "Failed to create echo server socket: $@";
    }
    
    $self->{server_socket} = $server_socket;
    $self->{port} = $server_socket->sockport;
    $self->{is_running} = 1;
    
    $self->{start_server_ch}->write(1);
    
    while (1) {
      
      unless ($self->{is_running}) {
        last;
      }
      
      Fn->defer([$self : Test::Server::Echo] method : void () {
        $self->{accepted_socket} = undef;
      });
      
      my $accepted_socket = (IO::Socket::IP)undef;
      eval {
        $accepted_socket = $server_socket->accept;
      };
      
      if ($@) {
        next;
      }
      
      $self->{accepted_socket} = $accepted_socket;
      
      my $read_data = (mutable string)new_string_len 1024;
      
      while (1) {
        my $read_length = 0;
        eval {
          $read_length = $accepted_socket->sysread($read_data);
        };
        
        if ($@) {
          last;
        }
        
        if ($read_length <= 0) {
          last;
        }
        
        my $write_length = 0;
        eval {
          $write_length = $accepted_socket->syswrite($read_data, $read_length);
        };
        
        if ($@) {
          last;
        }
      }
    }
    
    $self->{stop_server_ch}->write(1);
  }
  
  method stop : void () {
    if ($self->{is_running}) {
      my $server_socket = $self->{server_socket};
      if ($server_socket) {
        $server_socket->close;
        $self->{server_socket} = undef;
      }
      
      my $accepted_socket = $self->{accepted_socket};
      if ($accepted_socket) {
        $accepted_socket->close;
        $self->{accepted_socket} = undef;
      }
      
      $self->{start_server_ch} = undef;
      
      $self->{is_running} = 0;
      
      $self->{stop_server_ch}->read;
    }
  }
  
  method wait_start : void () {
    $self->{start_server_ch}->read;
  }
}
